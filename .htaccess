# Apache Configuration

# Issue-030 v1.7.2.3: defensive DirectoryIndex so a future
# cPanel-Index-Manager removal or a hosting migration does not
# re-introduce the / -> /login.php redirect. Note: this does NOT
# override an active cPanel Index Manager (which has higher
# precedence than .htaccess); the real fix for the v1.7.2.3 bug
# is the hPanel change in docs/issues/issue-030.md section 6.1.
# This line is belt-and-braces.
DirectoryIndex index.php index.html

RewriteEngine On

# v2.0 legacy .php -> slug 301s (issue-035 Appendix C.2 R11/R12).
#
# These entry points still exist and are still what the slug URLs dispatch
# to, but their own URLs must 301 to the canonical slug form. Apache would
# otherwise serve the real file directly, rendering the page at the old URL
# and leaving it in the address bar - which R11 forbids.
#
# The rewrite runs them through the front controller, which emits the 301 with
# the correct Location. Rules are evaluated top-down and [L] stops at the first
# match, so this must come before the catch-all below.
#
# Deliberately narrow: it names the legacy entry points explicitly instead of
# matching \.php$, so no other PHP file changes behaviour. It is placed after
# RewriteEngine On and before the catch-all, and it does not shadow any of the
# deny rules further down - those are <FilesMatch>/<DirectoryMatch> directives,
# not rewrites, so they are unaffected by this block.
RewriteRule ^(dashboard|projects|tasks|contacts|profile|login|register|logout|forgot_password|reset_password|project_detail|project_edit|project_delete|task_detail|task_edit|contact_detail|contact_edit)\.php$ index.php [QSA,L]

# Redirect to index.php if file doesn't exist
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Deny access to sensitive files
<FilesMatch "\.(ini|log|conf|sql|md)$">
    Require all denied
</FilesMatch>

# Deny access to specific directories
<DirectoryMatch "/(includes|database|docs|vendor)/">
    Require all denied
</DirectoryMatch>

# Deny access to configuration files
<FilesMatch "^(config|composer|package)\.">
    Require all denied
</FilesMatch>

# Issue-029 v1.7.2.2: deny public HTTP access to the prod sanity probe
# (the dev runs it from the shell, not from a browser). The file is
# safe to leave in public_html permanently because the deny rule
# blocks it from any non-shell request.
<FilesMatch "^_diag\.php$">
    Require all denied
</FilesMatch>

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-shockwave-flash "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresDefault "access plus 2 days"
</IfModule>