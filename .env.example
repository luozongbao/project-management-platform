# Copy this file to .env and adjust values for your environment.
# docker compose reads this file automatically.

# ---- Web server ----
# Host port that maps to the nginx container (container listens on 80).
APP_PORT=80

# Public URL the app uses when building absolute links (emails, redirects).
APP_URL=http://localhost

# ---- MariaDB / MySQL ----
DB_NAME=project_management
DB_USER=pmp_user
DB_PASSWORD=change_me_pmp_user
# Root password for the MariaDB container. Only used during database init.
MYSQL_ROOT_PASSWORD=change_me_root

# ---- SMTP (PHPMailer) ----
# These are read by the app container and used during the install wizard /
# written into config.php. Set them to your real SMTP credentials before
# triggering the install at http://localhost/ (or whatever APP_PORT you use).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_PROTOCOL=tls
SMTP_USER=
SMTP_PASS=