# Copy this file to .env and adjust values for your environment.
# docker compose reads this file automatically.

# ---- Web server ----
# Host port that maps to the nginx container (container listens on 80).
APP_PORT=80

# Public URL the app uses when building absolute links (emails, redirects).
APP_URL=http://localhost

# ---- MariaDB / MySQL ----
DB_NAME=project_management
DB_USER=pmp_user
DB_PASSWORD=change_me_pmp_user
# Root password for the MariaDB container. Only used during database init.
MYSQL_ROOT_PASSWORD=change_me_root

# ---- Host UID/GID (file ownership on bind mount) ----
# Files written into the bind-mounted project by the container (vendor/,
# config.php) get owned by root unless these match your host user. Use the
# output of `id -u` / `id -g` on the host. Defaults below are fine on most
# Linux desktops.
HOST_UID=1000
HOST_GID=1000

# ---- SMTP (PHPMailer) ----
# These are read by the app container and used during the install wizard /
# written into config.php. Set them to your real SMTP credentials before
# triggering the install at http://localhost/ (or whatever APP_PORT you use).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_PROTOCOL=tls
SMTP_USER=
SMTP_PASS=

# ---- v2.0 design mockup (dev only, see docs/issues/issue-036.md) ----
# Host port that maps to the static mockup container. The application uses
# APP_PORT (default 80); the mockup uses a different port so both can run
# at the same time.
#
#   docker compose up -d mockup   ->  http://localhost:${MOCKUP_PORT}/
MOCKUP_PORT=8080
